# 此檔只包含非機密設定；密鑰一律存入 Windows Credential Manager。
AEVRYND_LINE_ALLOWED_USER_IDS=U_REPLACE_WITH_ALLOWED_USER_ID
AEVRYND_LINE_ALLOWED_GROUP_IDS=C_REPLACE_WITH_ALLOWED_GROUP_ID
AEVRYND_LINE_BIND_HOST=127.0.0.1
AEVRYND_LINE_PORT=8787
AEVRYND_LINE_MAX_BODY_BYTES=262144
AEVRYND_LINE_REQUEST_TIMEOUT_SECONDS=5
AEVRYND_LINE_MAX_EVENTS_PER_WEBHOOK=100
AEVRYND_QWEN_BASE_URL=http://192.168.50.98:8080/v1
AEVRYND_QWEN_MODEL=Qwen3.8-27B-UD-Q4_K_M.gguf
# 第二台 Qwen 只在主要節點發生可重試錯誤且通過 authenticated slots gate 時接手單一請求。
AEVRYND_QWEN_SECONDARY_BASE_URL=http://100.89.42.36:8080/v1
AEVRYND_ASSISTANT_TAICHUNG_QWEN_ROLE=primary
AEVRYND_ASSISTANT_TAOYUAN_QWEN_ROLE=secondary
