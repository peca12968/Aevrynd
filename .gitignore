# RiftForge build outputs
/engine/build/
/build/
/build-native/
/build-ibl-*/
/build-release-*/
/*.obj
/.vs/
/.vscode/
**/CMakeFiles/
**/CMakeCache.txt
**/*.user
**/*.pdb

# Packaged games and player saves
/games/*/dist/
/games/*/saves/
/saves/
/Demo/

# Local AI runtime and large model weights
/engine/runtime/*
!/engine/runtime/README.md
*.gguf
*.safetensors

# Downloaded third-party SDKs
/engine/third_party/*
!/engine/third_party/README.md
*.zip

# Archived browser prototype and local runtimes
/games/*/legacy-web/

# Runtime logs and temporary files
/artifacts/
*.log
*.tmp
*.bak
__pycache__/
*.pyc
Thumbs.db
.DS_Store
