{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-gameplay-visual-gates",
      "inherits": "windows-release-gates",
      "displayName": "Windows Gameplay Production Visual Gates (VS2022 x64)",
      "description": "Production Gameplay capture with diagnostic hooks disabled; requires an interactive GPU session.",
      "cacheVariables": {
        "AEVRYND_INTERNAL_RENDERER_TEST_HOOKS": "OFF"
      }
    },
    {
      "name": "windows-visual-gates",
      "inherits": "windows-release-gates",
      "displayName": "Windows Visual Gates (VS2022 x64)",
      "description": "Fixed GPU capture and foliage regression; requires an interactive GPU session.",
      "cacheVariables": {
        "AEVRYND_INTERNAL_RENDERER_TEST_HOOKS": "ON"
      }
    },
    {
      "name": "windows-release-gates",
      "displayName": "Windows Release Gates (VS2022 x64)",
      "description": "Fixed non-interactive CPU release-gate configuration for restricted remote workers.",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/b",
      "cacheVariables": {
        "AEVRYND_ENABLE_STREAMLINE": "OFF",
        "AEVRYND_ENABLE_STREAMLINE_RUNTIME": "OFF",
        "AEVRYND_INTERNAL_RENDERER_TEST_HOOKS": "OFF",
        "AEVRYND_STREAMLINE_PACKAGE_TEST_TARGET": "ON"
      }
    },
    {
      "name": "windows-mistwatch-normal-gates",
      "inherits": "windows-release-gates",
      "displayName": "Windows Mistwatch production normal gates (VS2022 x64)",
      "description": "Full native ForestWood scene matrix; requires an available interactive D3D12 desktop. Not Gameplay.",
      "cacheVariables": {
        "AEVRYND_INTERNAL_RENDERER_TEST_HOOKS": "OFF",
        "AEVRYND_MISTWATCH_NATIVE_GATES": "ON"
      }
    },
    {
      "name": "windows-mistwatch-gbv-gates",
      "inherits": "windows-release-gates",
      "displayName": "Windows Mistwatch production gbv gates (VS2022 x64)",
      "description": "Full native ForestWood scene matrix; requires an available interactive D3D12 desktop. Not Gameplay.",
      "cacheVariables": {
        "AEVRYND_INTERNAL_RENDERER_TEST_HOOKS": "OFF",
        "AEVRYND_MISTWATCH_NATIVE_GATES": "ON"
      }
    },
    {
      "name": "windows-mistwatch-multiplayer-gates",
      "inherits": "windows-release-gates",
      "displayName": "Windows Mistwatch Multiplayer Gates (VS2022 x64)",
      "description": "Dedicated server and native networking checks without a graphics session.",
      "cacheVariables": {
        "AEVRYND_BUILD_MISTWATCH_SERVER_ONLY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-gameplay-visual-gates",
      "configurePreset": "windows-gameplay-visual-gates",
      "configuration": "Release",
      "targets": [
        "GameplayLab",
        "GameplayObjectIdentityContractProbe"
      ],
      "jobs": 2
    },
    {
      "name": "windows-visual-gates",
      "configurePreset": "windows-visual-gates",
      "configuration": "Release",
      "targets": [
        "GameplayLab",
        "GameplayObjectIdentityContractProbe",
        "AevryndAtmosphereFoliageCoverageD3D12VisualTest"
      ],
      "jobs": 2
    },
    {
      "name": "windows-release-gates",
      "configurePreset": "windows-release-gates",
      "configuration": "Release",
      "targets": [
        "AevryndStreamlinePackageFixture"
      ],
      "jobs": 2
    },
    {
      "name": "windows-mistwatch-normal-gates",
      "configurePreset": "windows-mistwatch-normal-gates",
      "configuration": "Release",
      "targets": [
        "Mistwatch"
      ],
      "jobs": 2
    },
    {
      "name": "windows-mistwatch-gbv-gates",
      "configurePreset": "windows-mistwatch-gbv-gates",
      "configuration": "Release",
      "targets": [
        "Mistwatch"
      ],
      "jobs": 2
    },
    {
      "name": "windows-mistwatch-multiplayer-gates",
      "configurePreset": "windows-mistwatch-multiplayer-gates",
      "configuration": "Release",
      "targets": [
        "MistwatchWorldServer",
        "MistwatchLocalWorldClientSmoke"
      ],
      "jobs": 1
    }
  ],
  "testPresets": [
    {
      "name": "windows-gameplay-visual-gates",
      "configurePreset": "windows-gameplay-visual-gates",
      "configuration": "Release",
      "filter": {
        "include": {
          "name": "^(GameplayLabCaptureSmoke|GameplayLabGpuValidationCaptureSmoke)$"
        }
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-visual-gates",
      "configurePreset": "windows-visual-gates",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "^visual-gates$"
        }
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release-gates",
      "configurePreset": "windows-release-gates",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "^release-gates$"
        }
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-mistwatch-normal-gates",
      "configurePreset": "windows-mistwatch-normal-gates",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "^mistwatch-native-normal$"
        }
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-mistwatch-gbv-gates",
      "configurePreset": "windows-mistwatch-gbv-gates",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "^mistwatch-native-gbv$"
        }
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-mistwatch-multiplayer-gates",
      "configurePreset": "windows-mistwatch-multiplayer-gates",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "^mistwatch-multiplayer-gates$"
        }
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
