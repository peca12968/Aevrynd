{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-gameplay-visual-gates",
      "inherits": "windows-release-gates",
      "displayName": "Windows Gameplay Production Visual Gates (VS2022 x64)",
      "description": "Production Gameplay capture with diagnostic hooks disabled; requires an interactive GPU session.",
      "cacheVariables": {
        "AEVRYND_INTERNAL_RENDERER_TEST_HOOKS": "OFF"
      }
    },
    {
      "name": "windows-visual-gates",
      "inherits": "windows-release-gates",
      "displayName": "Windows Visual Gates (VS2022 x64)",
      "description": "Fixed GPU capture and foliage regression; requires an interactive GPU session.",
      "cacheVariables": {
        "AEVRYND_INTERNAL_RENDERER_TEST_HOOKS": "ON"
      }
    },
    {
      "name": "windows-release-gates",
      "displayName": "Windows Release Gates (VS2022 x64)",
      "description": "Fixed non-interactive CPU release-gate configuration for restricted remote workers.",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/b",
      "cacheVariables": {
        "AEVRYND_ENABLE_STREAMLINE": "OFF",
        "AEVRYND_ENABLE_STREAMLINE_RUNTIME": "OFF",
        "AEVRYND_INTERNAL_RENDERER_TEST_HOOKS": "OFF",
        "AEVRYND_STREAMLINE_PACKAGE_TEST_TARGET": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-gameplay-visual-gates",
      "configurePreset": "windows-gameplay-visual-gates",
      "configuration": "Release",
      "targets": ["GameplayLab", "GameplayObjectIdentityContractProbe"],
      "jobs": 2
    },
    {
      "name": "windows-visual-gates",
      "configurePreset": "windows-visual-gates",
      "configuration": "Release",
      "targets": ["GameplayLab", "GameplayObjectIdentityContractProbe", "AevryndAtmosphereFoliageCoverageD3D12VisualTest"],
      "jobs": 2
    },
    {
      "name": "windows-release-gates",
      "configurePreset": "windows-release-gates",
      "configuration": "RelWithDebInfo",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "windows-gameplay-visual-gates",
      "configurePreset": "windows-gameplay-visual-gates",
      "configuration": "Release",
      "filter": {"include": {"name": "^(GameplayLabCaptureSmoke|GameplayLabGpuValidationCaptureSmoke)$"}},
      "execution": {"jobs": 1, "noTestsAction": "error", "stopOnFailure": false},
      "output": {"outputOnFailure": true}
    },
    {
      "name": "windows-visual-gates",
      "configurePreset": "windows-visual-gates",
      "configuration": "Release",
      "filter": {"include": {"label": "^visual-gates$"}},
      "execution": {"jobs": 1, "noTestsAction": "error", "stopOnFailure": false},
      "output": {"outputOnFailure": true}
    },
    {
      "name": "windows-release-gates",
      "configurePreset": "windows-release-gates",
      "configuration": "RelWithDebInfo",
      "filter": {
        "include": {
          "label": "^release-gates$"
        }
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
