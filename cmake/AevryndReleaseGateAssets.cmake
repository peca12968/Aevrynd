# 候選：統一部署既有權威清單的 249 個共用資產，不依賴展示 EXE。
cmake_minimum_required(VERSION 3.25)
if(NOT CMAKE_SCRIPT_MODE_FILE)
  if(NOT TARGET AevryndStreamlinePackageFixture)
    message(FATAL_ERROR "release_asset_fixture_missing")
  endif()
  add_custom_target(AevryndReleaseGateAssets
    COMMAND "${CMAKE_COMMAND}"
      "-DAEVRYND_ASSET_SOURCE_ROOT=${CMAKE_SOURCE_DIR}"
      "-DAEVRYND_ASSET_RUNTIME_ROOT=${CMAKE_BINARY_DIR}/bin/$<CONFIG>/assets"
      -P "${CMAKE_CURRENT_LIST_FILE}"
    VERBATIM)
  add_dependencies(AevryndStreamlinePackageFixture AevryndReleaseGateAssets)
  return()
endif()

foreach(required AEVRYND_ASSET_SOURCE_ROOT AEVRYND_ASSET_RUNTIME_ROOT)
  if(NOT DEFINED ${required} OR NOT IS_ABSOLUTE "${${required}}")
    message(FATAL_ERROR "release_asset_absolute_root_required:${required}")
  endif()
endforeach()
set(manifest "${AEVRYND_ASSET_SOURCE_ROOT}/games/mistwatch/native/tests/qualification/runtime-profiles-v1.json")
file(SHA256 "${manifest}" manifest_sha)
if(NOT manifest_sha STREQUAL "1a0cc543a038be1b98a5f32e27d9a37c11d53921536743b928fa36f712a8078a")
  message(FATAL_ERROR "release_asset_authority_manifest_drift")
endif()
file(READ "${manifest}" authority)
string(JSON count LENGTH "${authority}" entries)
math(EXPR last "${count}-1")
set(selected "")
set(allowed_scope "")
set(seen "")

function(reject_symlinks absolute_path)
  set(cursor "${absolute_path}")
  while(TRUE)
    if(IS_SYMLINK "${cursor}")
      message(FATAL_ERROR "release_asset_symlink:${cursor}")
    endif()
    get_filename_component(parent "${cursor}" DIRECTORY)
    if(parent STREQUAL cursor OR parent STREQUAL "")
      break()
    endif()
    set(cursor "${parent}")
  endwhile()
endfunction()

# 先驗證所有來源，再開始部署；期望值只取自舊權威清單，不從 runtime 回填。
foreach(index RANGE 0 ${last})
  string(JSON destination GET "${authority}" entries ${index} 0)
  if(NOT destination MATCHES "^(engine_probe\\.obj$|environment-material-packs/|environment-model-packs/|material-packs/|model-packs/|photoreal-cooked/)")
    continue()
  endif()
  string(TOLOWER "${destination}" folded)
  if(folded IN_LIST seen)
    message(FATAL_ERROR "release_asset_destination_collision:${destination}")
  endif()
  list(APPEND seen "${folded}")
  list(APPEND allowed_scope "${destination}")
  string(JSON source GET "${authority}" entries ${index} 1)
  string(JSON kind GET "${authority}" entries ${index} 3)
  string(JSON expected_size GET "${authority}" entries ${index} 4)
  string(JSON expected_sha GET "${authority}" entries ${index} 5)
  if(NOT kind STREQUAL "copy")
    message(FATAL_ERROR "release_asset_not_copy:${destination}")
  endif()
  foreach(relative "${source}" "${destination}")
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)|[:;\\\\]")
      message(FATAL_ERROR "release_asset_unsafe_path:${relative}")
    endif()
  endforeach()
  set(input "${AEVRYND_ASSET_SOURCE_ROOT}/${source}")
  reject_symlinks("${input}")
  reject_symlinks("${AEVRYND_ASSET_RUNTIME_ROOT}/${destination}")
  if(NOT EXISTS "${input}" OR IS_DIRECTORY "${input}")
    message(FATAL_ERROR "release_asset_source_missing:${source}")
  endif()
  file(SIZE "${input}" actual_size)
  file(SHA256 "${input}" actual_sha)
  string(TOUPPER "${actual_sha}" actual_sha)
  if(NOT actual_size EQUAL expected_size OR NOT actual_sha STREQUAL expected_sha)
    message(FATAL_ERROR "release_asset_source_identity:${source}")
  endif()
  list(APPEND selected "${index}")
endforeach()
list(LENGTH selected selected_count)
list(LENGTH allowed_scope allowed_count)
if(NOT selected_count EQUAL 249 OR NOT allowed_count EQUAL 249)
  message(FATAL_ERROR "release_asset_membership_mismatch")
endif()

# 僅檢查本候選的部署範圍；其他並行相依尚可能正在產生其餘 167 個資產。
file(GLOB_RECURSE existing LIST_DIRECTORIES FALSE RELATIVE "${AEVRYND_ASSET_RUNTIME_ROOT}" "${AEVRYND_ASSET_RUNTIME_ROOT}/*")
foreach(path IN LISTS existing)
  if(path MATCHES "^(engine_probe\\.obj$|environment-material-packs/|environment-model-packs/|material-packs/|model-packs/|photoreal-cooked/)" AND NOT path IN_LIST allowed_scope)
    message(FATAL_ERROR "release_asset_unexpected_path:${path}")
  endif()
endforeach()
foreach(index IN LISTS selected)
  string(JSON destination GET "${authority}" entries ${index} 0)
  string(JSON source GET "${authority}" entries ${index} 1)
  string(JSON expected_sha GET "${authority}" entries ${index} 5)
  set(output "${AEVRYND_ASSET_RUNTIME_ROOT}/${destination}")
  get_filename_component(directory "${output}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  file(COPY_FILE "${AEVRYND_ASSET_SOURCE_ROOT}/${source}" "${output}" ONLY_IF_DIFFERENT)
  file(SHA256 "${output}" actual_sha)
  string(TOUPPER "${actual_sha}" actual_sha)
  if(NOT actual_sha STREQUAL expected_sha)
    message(FATAL_ERROR "release_asset_output_identity:${destination}")
  endif()
endforeach()
message(STATUS "RELEASE_GATE_ASSET_COPY_VERIFIED:249; full_runtime_validation_pending")
