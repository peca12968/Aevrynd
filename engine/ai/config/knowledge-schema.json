{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "id", "kind", "sourcePath", "sourceSha256",
        "sourceRevision", "license", "trainingEligible", "engineVersion",
        "offset", "symbol", "content"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^aec-[0-9]{5}$" },
        "kind": { "enum": ["info", "public-header", "test", "tool", "build", "git-commit"] },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "trainingEligible": { "type": "boolean" },
        "engineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "offset": { "type": "integer", "minimum": 0 },
        "symbol": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "engineVersion", "snapshotRevision", "chunkCharacters", "chunkCount",
        "sourceCount", "defaultLicense", "trainingEligible", "sensitiveContentScan", "knowledgeSha256",
        "sources", "exclusions"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "engineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "snapshotRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "chunkCharacters": { "type": "integer", "minimum": 256, "maximum": 4096 },
        "chunkCount": { "type": "integer", "minimum": 1 },
        "sourceCount": { "type": "integer", "minimum": 1 },
        "defaultLicense": { "type": "string", "minLength": 1 },
        "trainingEligible": { "const": false },
        "sensitiveContentScan": { "const": "passed" },
        "knowledgeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "sha256", "revision", "bytes"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["info", "public-header", "test", "tool", "build"] },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "revision": { "type": "string", "minLength": 1 },
              "bytes": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
